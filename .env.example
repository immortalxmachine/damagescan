# Copy this file to `.env` and fill in values. `.env` is git-ignored.

# Path to the exported ONNX model the API / Gradio demo should serve.
MODEL_PATH=models/resnet18.onnx

# Kaggle credentials are read from ~/.kaggle/kaggle.json by the kaggle client,
# so you do NOT need them here. Alternatively you may set them as env vars:
# KAGGLE_USERNAME=your_username
# KAGGLE_KEY=your_api_key
